# Supabase (Project Settings → API — use anon key in the app only)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# When both are set, the app uses Supabase Edge Functions for orders + driver APIs
# (deploy: supabase functions deploy orders && supabase functions deploy driver-orders).
# Otherwise it uses EXPO_PUBLIC_API_BASE_URL below (legacy Node backend).

# Google Maps (Maps SDK + Places)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Legacy backend API only if Supabase URL is not set (no trailing slash)
EXPO_PUBLIC_API_BASE_URL=

# Driver sign-up screen: phone / WhatsApp (E.164, default +962772182987)
# EXPO_PUBLIC_DRIVER_CONTACT_PHONE=

